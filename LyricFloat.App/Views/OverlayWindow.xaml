<Window x:Class="LyricFloat.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricFloat"
        Width="760" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border x:Name="LyricContainer" Background="Transparent" Padding="24,20" Cursor="SizeAll"
            ToolTip="{Binding InteractionHint}">
        <StackPanel VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" BlurRadius="6"
                                              ShadowDepth="1" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <TextBlock x:Name="SongCaption" Text="{Binding SongInfo}" FontSize="14" Opacity="0.65" Height="20"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PreviousText" Text="{Binding PreviousLyric}" FontSize="22" Opacity="0.45" MaxHeight="56" />
            <TextBlock x:Name="CurrentText" Text="{Binding CurrentLyric}" FontSize="34" FontWeight="SemiBold"
                       Margin="0,10" MaxHeight="88" />
            <TextBlock x:Name="NextText" Text="{Binding NextLyric}" FontSize="22" Opacity="0.45" MaxHeight="56" />
            <TextBlock x:Name="PauseCaption" Text="{Binding PauseIndicator}" FontSize="12" Opacity="0.55" Height="18" />
        </StackPanel>
    </Border>
</Window>
